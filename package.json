    "react-native",
    "react-native-mmkv",
    "storage",
    "sync",
    "synchronous",
    "unstorage",
    "unstorage-sync"
  ],
  "homepage": "https://github.com/leonsilicon/unstorage-sync-react-native-mmkv#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/unstorage-sync-react-native-mmkv/issues"
  },
  "license": "MIT",
  "author": "Leon Si <leon@leonsilicon.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/unstorage-sync-react-native-mmkv.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
