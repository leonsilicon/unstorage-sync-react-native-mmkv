  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "react-native-mmkv": "^4.3.2",
    "typescript": "^7.0.2",
    "unstorage-sync": "^0.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "react-native-mmkv": "^3.0.0 || ^4.0.0",
    "unstorage-sync": "^0.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
